PORT=4000

# Unique identifier for this server instance (used in round audit records)
SERVER_INSTANCE_ID=aviator-server-1

# Base URL of the platform NestJS backend (igaming-nestjs-template) — every
# real-money operation (wallet balance, bet place/cancel/cashout, admin
# config) is proxied through its Aviator module instead of local storage.
NEST_API_URL=http://localhost:3000

# Long-lived admin-role game-session token for this engine to poll
# winMode/forcedCrash at the start of every round. Minted once via
# SpinforgeGameSessionService.issue(systemAdminId, gameId, 'admin') on the
# platform backend — see docs/AVIATOR.md there for details.
AVIATOR_ENGINE_SESSION_TOKEN=

# Secret used to sign/verify the LOCAL ADMIN PANEL token only (HMAC-SHA256).
# Real players never get a token from this engine — they arrive already
# authenticated via the platform's own game-session token.
# Change this to a long random string in production.
ADMIN_TOKEN_SECRET=change-me-to-a-random-secret

# Comma-separated list of allowed origins for CORS
# Use "*" for development, your production domain for production
CORS_ORIGIN=*
